# Optional zero-config bind (see README). Do not commit secrets.
# TASKMARK_BOARD=/absolute/path/to/board-or-product-root
# TASKMARK_MASTER=/absolute/path/to/master-folder
# TASKMARK_CWD=/absolute/path/to/product-root
# Prefer TASKMARK_SYNC_TOKEN in the bound board's committed .config file.
# Environment fallback only:
# TASKMARK_SYNC_TOKEN=tmk_...
# Origin of the Taskmark Cloud app, which proxies to the API — never the API itself.
# Defaults to https://cloud.taskmark.dev; set only for self-hosted or local stacks.
# TASKMARK_CLOUD_URL=http://localhost:8001

