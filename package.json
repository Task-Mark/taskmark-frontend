{
  "name": "@taskmark/ui",
  "version": "0.2.5",
  "description": "Local Taskmark board UI — install in a board folder and run `npx taskmark serve` or `npx taskmark build`",
  "private": false,
  "type": "module",
  "bin": {
    "taskmark": "./bin/taskmark.js"
  },
  "files": [
    "app",
    "bin",
    "components",
    "hooks",
    "lib",
    "public",
    "scripts",
    "dist/standalone",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "tsconfig.snapshot.json",
    "components.json",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start",
    "serve": "node ./bin/taskmark.js serve",
    "preview": "node ./bin/taskmark.js preview",
    "prepack": "npm run build",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.3",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "shadcn": "^4.13.1",
    "tsx": "^4.20.3"
  }
}
